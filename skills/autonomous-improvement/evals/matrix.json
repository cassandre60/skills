{
  "schema": "matrix/1",
  "description": "Measurement matrix for the autonomous-improvement skill. Each fixture plants one known condition; a run is scored 0-1 against it. dev split gates changes; heldout split is never shown to the improver except as aggregate verdicts. Fixtures whose toolcheck commands are missing are skipped and reported as skipped, never failed. The owner can add real repositories to the held-out set through an untracked evals/heldout.local.json (list of {id, path, stack, planted, expected_tools}).",
  "score_parts": {
    "complete_no_blocking_question": 0.3,
    "tool_within_expected": 0.3,
    "evidence_complete": 0.2,
    "scope_within_budget": 0.2
  },
  "diff_budget_files": 4,
  "fixtures": [
