{
  "base_ref": "origin/main",
  "ledger_path": "docs/AUTONOMOUS_WORK_LEDGER.md",
  "origin_url": null,
  "setup_cmds": [
    [
      "fvm",
      "flutter",
      "pub",
      "get"
    ],
    [
      "fvm",
      "dart",
      "run",
      "build_runner",
      "build",
      "--delete-conflicting-outputs"
    ],
    [
      "fvm",
      "dart",
      "format",
      "lib/l10n/"
    ]
  ],
  "format_check_cmd": [
    "fvm",
    "dart",
    "format",
    "--output=none",
    "--set-exit-if-changed",
    "lib",
    "test"
  ],
  "analyze_cmd": [
    "fvm",
    "flutter",
    "analyze"
  ],
  "analyze_extensions": [
    ".dart"
  ],
  "gate_cmd": [
    "./scripts/gates.sh",
    "t1"
  ],
  "test_cmd": [
    "fvm",
    "flutter",
    "test"
  ],
  "test_for_source": [
    {
      "src": "^lib/src/(.*)\\.dart$",
      "test": "test/\\1_test.dart"
    }
  ],
  "candidates": {
    "A": {
      "include": [
        "lib/src/**/*.dart"
      ],
      "exclude": [
        "**/*.g.dart",
        "**/*.freezed.dart",
        "**/*.mocks.dart",
        "**/l10n/**"
      ],
      "require_test": true,
      "priority_paths": [
        "lib/src/domain"
      ]
    },
    "B": {
      "include": [
        "test/**/*_test.dart"
      ],
      "exclude": [
        "test/**/*.mocks.dart"
      ],
      "priority_paths": []
    }
  },
  "pr_required": {
    "COMPLETED": true,
    "SOUND": false
  },
  "_comment": "The mapping is REPO-SPECIFIC. The rule below matches this repo's layout (lib/src/<rest>.dart <-> test/<rest>_test.dart). A repo that mirrors the whole source tree into the test tree needs '^lib/(.*)\\\\.dart$' -> 'test/\\\\1_test.dart' instead. VERIFY IT: pick a source file, run `ledger.py check --target <file>` and confirm the mapped test is the one that actually asserts on it. The conservative fallback heuristic keeps the 'src/' segment and resolves for 0 files in a repo laid out like this one, and it fails silently."
}
